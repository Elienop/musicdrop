mendation": {"$ref": "#/components/schemas/Recommendation"}, "data_source": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Data Source"}, "data_url": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Data Url"}, "cover_after_url": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Cover After Url"}, "has_current_art": {"type": "boolean", "title": "Has Current Art"}, "changed_fields": {"items": {"type": "string"}, "type": "array", "title": "Changed Fields"}, "album_before": {"$ref": "#/components/schemas/AlbumChange"}, "album_after": {"$ref": "#/components/schemas/AlbumChange"}, "tracks": {"items": {"$ref": "#/components/schemas/TrackChange"}, "type": "array", "title": "Tracks"}, "missing": {"items": {"$ref": "#/components/schemas/MissingTrack"}, "type": "array", "title": "Missing"}, "unmatched": {"items": {"$ref": "#/components/schemas/UnmatchedItem"}, "type": "array", "title": "Unmatched"}, "options": {"items": {"$ref": "#/components/schemas/CandidateOption"}, "type": "array", "title": "Options"}}, "type": "object", "required": ["confidence", "recommendation", "data_source", "data_url", "cover_after_url", "has_current_art", "changed_fields", "album_before", "album_after", "tracks", "missing", "unmatched", "options"], "title": "Candidate", "description": "The full mapped payload for the top match of one album.\n\nEverything the review screen renders: confidence/recommendation, the album\nbefore/after diff, the per-track diff, missing/unmatched tracks, and the\nranked alternative releases."}, "CandidateOption": {"properties": {"index": {"type": "integer", "title": "Index"}, "confidence": {"type": "number", "title": "Confidence"}, "data_source": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Data Source"}, "disambiguation": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Disambiguation"}}, "type": "object", "required": ["index", "confidence", "data_source", "disambiguation"], "title": "CandidateOption", "description": "A ranked alternative release from ``task.candidates``.\n\nThe switcher in the review screen lists these; ``index`` is the position in\nthe beets candidate list and is what a choice references."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "HealthResponse": {"properties": {"status": {"type": "string", "title": "Status"}, "version": {"type": "string", "title": "Version"}}, "type": "object", "required": ["status", "version"], "title": "HealthResponse"}, "ImportAction": {"type": "string", "enum": ["apply", "skip", "asis", "astracks", "abort"], "title": "ImportAction", "description": "The decisions the user can return for a parked album.\n\nSubset of beets' choices relevant to chunk 1 (enter-id / search-again are a\nlater chunk). ``apply`` selects a ranked option by index; ``abort`` stops the\nwhole import (the session raises beets' ``ImportAbortError``, which beets'\n``run()`` catches to stop cleanly)."}, "ImportAlbumStatus": {"type": "string", "enum": ["needs_review", "decided", "applied", "skipped"], "title": "ImportAlbumStatus", "description": "Per-album state in the live feed.\n\nneeds_review -> parked, awaiting the user's decision (the current album)\ndecided      -> the user decided a parked album (apply/skip/asis/astracks)\napplied      -> a strong match auto-applied in the worker (never parked)\nskipped      -> the worker skipped it (no candidates)"}, "ImportAlbumSummary": {"properties": {"index": {"type": "integer", "title": "Index"}, "folder": {"type": "string", "title": "Folder"}, "artist": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Artist"}, "album": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Album"}, "recommendation": {"$ref": "#/components/schemas/Recommendation"}, "confidence": {"type": "number", "title": "Confidence"}, "status": {"$ref": "#/components/schemas/ImportAlbumStatus"}}, "type": "object", "required": ["index", "folder", "artist", "album", "recommendation", "confidence", "status"], "title": "ImportAlbumSummary", "description": "One row in the live feed (the GET /api/import/{job} listing).\n\nThe full per-album diff is fetched separately via\n``GET /api/import/{job}/albums/{index}`` (only meaningful while an album is\n``needs_review``); this is the compact feed row."}, "ImportChoice": {"properties": {"action": {"$ref": "#/components/schemas/ImportAction"}, "candidate_index": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Candidate Index"}}, "type": "object", "required": ["action"], "title": "ImportChoice", "description": "A user's decision for one parked album, pushed back over the bridge."}, "ImportJobState": {"properties": {"job_id": {"type": "string", "title": "Job Id"}, "phase": {"$ref": "#/components/schemas/ImportPhase"}, "progress": {"$ref": "#/components/schemas/ImportProgress"}, "albums": {"items": {"$ref": "#/components/schemas/ImportAlbumSummary"}, "type": "array", "title": "Albums"}, "summary": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Summary"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Error"}}, "type": "object", "required": ["job_id", "phase", "progress", "albums", "summary", "error"], "title": "ImportJobState", "description": "Response of ``GET /api/import/{job}``: phase + progress + the live feed."}, "ImportPhase": {"type": "string", "enum": ["scanning", "reviewing", "applying", "done", "failed"], "title": "ImportPhase", "description": "Coarse lifecycle phase of an import job (the registry owns transitions).\n\nscanning  -> the worker is reading/grouping/looking up (nothing parked yet)\nreviewing -> an album is parked-and-waiting for a decision\napplying  -> reserved (beets exposes no signal to set it transiently)\ndone      -> the import finished (incl. a clean abort)\nfailed    -> the worker raised; ``error`` holds the message"}, "ImportProgress": {"properties": {"applied": {"type": "integer", "title": "Applied"}, "needs_review": {"type": "integer", "title": "Needs Review"}}, "type": "object", "required": ["applied", "needs_review"], "title": "ImportProgress", "description": "Coarse progress counters derived from the drained outcomes."}, "MissingTrack": {"properties": {"index": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Index"}, "title": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Title"}}, "type": "object", "required": ["index", "title"], "title": "MissingTrack", "description": "A track present on the matched release but absent from the folder.\n\nMaps from ``AlbumMatch.extra_tracks`` (beets' name for release-only tracks)."}, "Recommendation": {"type": "string", "enum": ["none", "low", "medium", "strong"], "title": "Recommendation", "description": "Mirror of beets' Recommendation enum (beets/autotag/match.py).\n\nBeets uses an IntEnum (none=0..strong=3); we expose the names as strings so\nthe JSON contract is self-describing for the frontend."}, "SearchResults": {"properties": {"artists": {"items": {"$ref": "#/components/schemas/Artist"}, "type": "array", "title": "Artists"}, "albums": {"items": {"$ref": "#/components/schemas/Album"}, "type": "array", "title": "Albums"}, "tracks": {"items": {"$ref": "#/components/schemas/SearchTrack"}, "type": "array", "title": "Tracks"}, "artist_total": {"type": "integer", "title": "Artist Total"}, "album_total": {"type": "integer", "title": "Album Total"}, "track_total": {"type": "integer", "title": "Track Total"}}, "type": "object", "required": ["artists", "albums", "tracks", "artist_total", "album_total", "track_total"], "title": "SearchResults"}, "SearchTrack": {"properties": {"id": {"type": "integer", "title": "Id"}, "title": {"type": "string", "title": "Title"}, "artist": {"type": "string", "title": "Artist"}, "album": {"type": "string", "title": "Album"}, "album_id": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Album Id"}, "duration_seconds": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Duration Seconds"}}, "type": "object", "required": ["id", "title", "artist", "album", "album_id", "duration_seconds"], "title": "SearchTrack"}, "StartImportRequest": {"properties": {"path": {"type": "string", "minLength": 1, "title": "Path"}, "options": {"anyOf": [{"additionalProperties": {"type": "string"}, "type": "object"}, {"type": "null"}], "title": "Options"}}, "type": "object", "required": ["path"], "title": "StartImportRequest", "description": "Body of ``POST /api/import``.\n\n``path`` is a server-side folder (maps 1:1 to ``beet import <path>``).\n``options`` is reserved for future per-import overrides (copy/move/autotag);\nv1 reads those from the user's beets config, so it is accepted but unused."}, "StartImportResponse": {"properties": {"job_id": {"type": "string", "title": "Job Id"}}, "type": "object", "required": ["job_id"], "title": "StartImportResponse", "description": "Response of a successful ``POST /api/import``: the new job's id."}, "Track": {"properties": {"id": {"type": "integer", "title": "Id"}, "title": {"type": "string", "title": "Title"}, "track": {"type": "integer", "title": "Track"}, "disc": {"type": "integer", "title": "Disc"}, "duration_seconds": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Duration Seconds"}, "artist": {"type": "string", "title": "Artist"}}, "type": "object", "required": ["id", "title", "track", "disc", "duration_seconds", "artist"], "title": "Track"}, "TrackChange": {"properties": {"index": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Index"}, "status": {"$ref": "#/components/schemas/TrackChangeStatus"}, "title_before": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Title Before"}, "title_after": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Title After"}, "track_before": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Track Before"}, "track_after": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Track After"}}, "type": "object", "required": ["index", "status", "title_before", "title_after", "track_before", "track_after"], "title": "TrackChange", "description": "One matched track row, current (``*_before``) vs proposed (``*_after``)."}, "TrackChangeStatus": {"type": "string", "enum": ["unchanged", "changed"], "title": "TrackChangeStatus", "description": "How a matched track row differs from the current file."}, "UnmatchedItem": {"properties": {"title": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Title"}, "track": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Track"}}, "type": "object", "required": ["title", "track"], "title": "UnmatchedItem", "description": "A local file with no counterpart on the matched release.\n\nMaps from ``AlbumMatch.extra_items`` (beets' name for folder-only files)."}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}